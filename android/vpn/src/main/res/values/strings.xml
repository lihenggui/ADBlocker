<resources>
    <!-- Notification channels, as listed in the system's settings. -->
    <string name="vpn_channel_running">Filtering</string>
    <string name="vpn_channel_stopped">Filtering stopped</string>

    <!-- The ongoing notification while the VPN runs. -->
    <string name="vpn_starting">Starting filtering</string>
    <plurals name="vpn_filtering">
        <item quantity="one">Filtering %d app</item>
        <item quantity="other">Filtering %d apps</item>
    </plurals>
    <string name="vpn_no_apps">No apps chosen</string>
    <!-- %s is a time of day. -->
    <string name="vpn_paused_until">Paused until %s</string>
    <string name="vpn_paused">Paused</string>
    <string name="vpn_action_pause_hour">Pause 1 hour</string>
    <!-- Notification action that resumes filtering. -->
    <string name="vpn_action_resume">Resume</string>
    <!-- Notification action that opens ADBlocker. -->
    <string name="vpn_action_open">Open</string>

    <!-- Posted once when another VPN app takes over. -->
    <string name="vpn_revoked_title">Filtering stopped</string>
    <!-- Security: Losing the local VPN stops filtering for the selected apps. -->
    <string name="vpn_revoked_text">The VPN was turned off by another VPN app or in the system settings. The chosen apps connect without filtering.</string>
    <string name="vpn_status_unavailable">Filtering status unavailable</string>
</resources>
