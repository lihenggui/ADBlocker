    <string name="feature_onboarding_check_kernel">核心功能</string>
    <string name="feature_onboarding_check_arch">處理器</string>
    <string name="feature_onboarding_check_root_failed">尚未授權。請在 root 管理工具 (KernelSU、Magisk 或 APatch) 中授予 ADBlocker root 權限。</string>
    <string name="feature_onboarding_check_android_failed">需要 Android 12 以上版本</string>
    <string name="feature_onboarding_check_kernel_failed">缺少過濾所需的功能</string>
