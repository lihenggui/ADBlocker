    <string name="feature_onboarding_welcome_text">브라우저 광고 차단기의 필터 목록으로 선택한 앱의 네트워크 요청을 필터링합니다.</string>
    <string name="feature_onboarding_start">시작</string>
    <string name="feature_onboarding_fact_private">ADBlocker는 자체 데이터를 전송하지 않습니다. 선택한 앱의 연결을 전달하고 필터 목록을 다운로드하는 일만 합니다.</string>
    <string name="feature_onboarding_fact_methods">root 모드 또는 VPN 모드에서 작동합니다.</string>
