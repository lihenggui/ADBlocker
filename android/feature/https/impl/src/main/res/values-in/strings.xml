    <string name="feature_https_impact_remove">Sertifikat dapat dihapus kapan saja di setelan sistem. Setelan › HTTPS membuka setelan tersebut.</string>
    <string name="feature_https_install_title">Instal sertifikat</string>
    <string name="feature_https_install_text">Android tidak mengizinkan aplikasi menginstal sertifikat. Sertifikat diinstal melalui setelan sistem.</string>
