<!--
  An app trusts the system store only, as this one does for every host but
  one. For that one it trusts only what the user added, as a browser built
  on Chromium goes by: the two halves of what the module has to provide.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- A pin no certificate has: the app refuses every one for this host,
         as an app that pins it refuses ADBlocker's. -->
    <domain-config>
        <domain includeSubdomains="false">example.net</domain>
        <pin-set>
            <pin digest="SHA-256">AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</pin>
        </pin-set>
    </domain-config>
    <domain-config>
        <domain includeSubdomains="false">www.wikipedia.org</domain>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
